---
# Copy to group_vars/all.yml (gitignored). Keep only placeholders in this file.

# The host's sudo admin, as created by ansible-server-bootstrap. Ansible connects as it.
admin_user: deploy

# The vault's hostname, without https://. Its DNS record must point at the host.
vaultwarden_domain: vault.example.com

# Argon2 hash of the /admin password, in single quotes. /admin stays off while this is unset.
# See docs/first-account.md.
# vaultwarden_admin_token: '$argon2id$...'
