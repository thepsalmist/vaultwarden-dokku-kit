# Public-safe example values for Vaultwarden on Dokku.
# Copy values into Dokku config or your private Ansible vars. Do not commit real secrets.

VAULTWARDEN_APP=vaultwarden
VAULTWARDEN_DOMAIN=https://vault.example.com
VAULTWARDEN_EMAIL=admin@example.com

# Vaultwarden runtime
DOMAIN=https://vault.example.com
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=false
SHOW_PASSWORD_HINT=false
WEBSOCKET_ENABLED=true

# Optional admin page. Prefer a strong generated token and keep it private.
ADMIN_TOKEN=

# SMTP example placeholders
SMTP_HOST=smtp.example.com
SMTP_FROM=admin@example.com
SMTP_FROM_NAME=Vaultwarden
SMTP_SECURITY=starttls
SMTP_PORT=587
SMTP_USERNAME=admin@example.com
SMTP_PASSWORD=

# Backup placeholders
BACKUP_RETENTION_DAYS=30
BACKUP_REMOTE=
